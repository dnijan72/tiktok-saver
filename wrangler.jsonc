{
  "name": "tiktok-saver",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": { "bindings": [{ "name": "JOBS", "class_name": "Jobs" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Jobs"] }]
}
